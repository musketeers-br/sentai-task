    // The seeded use-case flows: "Weekly maintenance window" (docs/use-case-weekly-maintenance.md)
    // and the two failure demos that show the product's honest failure behaviour
    // (docs/use-case-failure-demos.md), seeded with the image so a fresh
    // `docker compose up -d` already lists them - nothing manual. Run as its own iris session
    // AFTER iris.script has loaded the module, for the same stdin reason as
    // iris-provider.script (the zpm shell consumes the rest).
    //
    // Idempotent: each flow is created only when no flow of that name exists, so an operator
    // who edited or removed a demo is never overwritten. Installs made with zpm alone get
    // the class, not the data - the documents show the one-line calls that seed them.
    zn "IRISAPP"
    set demoFlowId = ##class(sentai.demo.DemoFlows).EnsureSeeded()
    if (demoFlowId = "") write "demo flow seed failed", !
    set failingCheckId = ##class(sentai.demo.FailureFlows).EnsureSeeded("failing-check")
    if (failingCheckId = "") write "failure demo seed failed: failing-check", !
    set postureId = ##class(sentai.demo.FailureFlows).EnsureSeeded("security-posture")
    if (postureId = "") write "failure demo seed failed: security-posture", !
    halt
