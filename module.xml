<?xml version="1.0" encoding="UTF-8"?>
<Export generator="Cache" version="25">
  <Document name="sentai-task.ZPM">
    <Module>
      <Name>sentai-task</Name>
      <Version>0.0.10</Version>
      <Description>Basic InterSystems IRIS Development Template</Description>
      <Packaging>module</Packaging>
      <SourcesRoot>src</SourcesRoot>

      <Resource Name="sentai.PKG"/>
      <UnitTest Name="/tests" Package="sentai.unittest" Phase="test"/>

      <!-- REST surface (research.md R-002): password + JWT authentication, never
           Unauthenticated; same 60 s access-token mechanism as /api/admin. No MatchRoles:
           the operator runs with their own platform roles (Constitution III). -->
      <CSPApplication
        Url="/csp/sentai/api/v1"
        DispatchClass="sentai.rest.Dispatcher"
        PasswordAuthEnabled="1"
        UnauthenticatedEnabled="0"
        JWTAuthEnabled="1"
        JWTAccessTokenTimeout="60"
        JWTRefreshTokenTimeout="900"
        Recurse="1"
        UseSessionCookie="0"
        CookiePath="/csp/sentai/api/v1/"/>

      <!-- The canvas (static SvelteKit build in /opt/sentai-web), served by
           sentai.web.StaticFiles. Unauthenticated on purpose: the page itself is public
           HTML/JS/CSS, and the operator signs in once, in the canvas, which exchanges the
           password for API tokens. No data is reachable here — the file server reads only
           /opt/sentai-web, and every flow/run call goes to /csp/sentai/api/v1 (JWT).
           SentaiWebPage (created in iris.script) only lets the anonymous request enter the
           IRISAPP namespace: read on its default globals database, nothing else. -->
      <CSPApplication
        Url="/csp/sentai"
        DispatchClass="sentai.web.StaticFiles"
        PasswordAuthEnabled="0"
        UnauthenticatedEnabled="1"
        MatchRoles=":SentaiWebPage"
        Recurse="1"
        UseSessionCookie="0"
        CookiePath="/csp/sentai/"/>

    </Module>
  </Document>
</Export>
