{
  "$comment": "SentaiTask design tokens. Every colour carries an explicit value per theme. No light value is computed from its dark counterpart (Constitution VI). Source of truth: contracts/ui/UI-006-design-system.md.",
  "version": "1.0.0",
  "font": {
    "display": "'Chakra Petch', system-ui, sans-serif",
    "ui": "'IBM Plex Sans', system-ui, sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, monospace",
    "numeric": { "fontVariantNumeric": "tabular-nums" }
  },
  "size": {
    "micro": 10, "caption": 11, "body": 12, "bodyStrong": 13,
    "title": 14, "sectionTitle": 17, "metric": 18, "display": 22
  },
  "radius": { "chip": 3, "control": 4, "node": 6, "panel": 6 },
  "space": { "hair": 2, "tight": 4, "snug": 7, "base": 10, "loose": 14, "section": 16, "page": 24 },
  "chrome": {
    "topBarHeight": 52,
    "statusBarHeight": 32,
    "waveProgressHeight": 54,
    "paletteWidth": 248,
    "inspectorWidth": 320,
    "runRailWidth": 348,
    "catalogDetailWidth": 380,
    "rowHeight": 38,
    "rowHeightSelected": 40,
    "gridDot": 16,
    "snap": 8
  },
  "theme": {
    "dark": {
      "ground": "#0A0D13",
      "groundRail": "#0E121A",
      "surface": "#10141D",
      "card": "#141A26",
      "cardRaised": "#161C29",
      "border": "#2B3648",
      "borderFaint": "#232C3D",
      "borderStrong": "#3A465C",
      "text": "#E6EBF2",
      "textStrong": "#F2F5FA",
      "textMuted": "#94A3B8",
      "textFaint": "#6F7E93",
      "gridDot": "#1C2433",
      "link": "#7FC4FF",
      "linkHover": "#B7DEFF",
      "focusRing": "#7FC4FF"
    },
    "light": {
      "ground": "#EFEDE7",
      "groundRail": "#F7F5F1",
      "surface": "#FFFFFF",
      "card": "#FFFFFF",
      "cardRaised": "#FFFFFF",
      "border": "#C9C3B6",
      "borderFaint": "#E7E3DA",
      "borderStrong": "#D2CDC2",
      "text": "#16181D",
      "textStrong": "#16181D",
      "textMuted": "#5C6473",
      "textFaint": "#7A8296",
      "gridDot": "#DAD6CC",
      "link": "#1F5FA8",
      "linkHover": "#123E70",
      "focusRing": "#1F5FA8",
      "cardShadow": "0 1px 2px rgba(22,24,29,0.07)"
    }
  },
  "state": {
    "$comment": "Shape is the contract and never varies; colour is a token per theme. See UI-006.",
    "queued":    { "shape": "dashed-hollow-square", "dark": "#A6B2C4", "light": "#6B7280" },
    "running":   { "shape": "pointing-triangle",    "dark": "#2FD0E8", "light": "#0E7C96" },
    "paused":    { "shape": "two-vertical-bars",    "dark": "#E8A33D", "light": "#9A6A00" },
    "completed": { "shape": "filled-circle-check",  "dark": "#3FBF6F", "light": "#1F8E52" },
    "failed":    { "shape": "filled-warning-triangle", "dark": "#F2495C", "light": "#C0212F" },
    "cancelled": { "shape": "slashed-circle",       "dark": "#98A3B4", "light": "#6B7280" }
  },
  "stateText": {
    "$comment": "Text colour for the state word, meeting 4.5:1 on that theme's card.",
    "queued":    { "dark": "#A6B2C4", "light": "#4D5567" },
    "running":   { "dark": "#9BE9F5", "light": "#0B5F73" },
    "paused":    { "dark": "#F2D9A0", "light": "#7A5200" },
    "completed": { "dark": "#86E3AA", "light": "#1B6E43" },
    "failed":    { "dark": "#FFB3B9", "light": "#A5192A" },
    "cancelled": { "dark": "#98A3B4", "light": "#4D5567" }
  },
  "category": {
    "$comment": "Step-type categories. Also the five hues of the product mark. Never used for state.",
    "verification": { "dark": "#FF3B4A", "light": "#D91F2E" },
    "storage":      { "dark": "#3B8DFF", "light": "#1F6FD6" },
    "journal":      { "dark": "#FFC93B", "light": "#C68A00" },
    "purge":        { "dark": "#35D07F", "light": "#1F8E52" },
    "backup":       { "dark": "#FF6FB5", "light": "#C4468C" },
    "custom":       { "dark": "#9AA7BC", "light": "#7A8296" }
  },
  "mark": {
    "bars": ["verification", "storage", "journal", "purge", "backup"],
    "heights": [20, 16, 12, 16, 20],
    "barWidth": 4,
    "gap": 2
  },
  "destructive": {
    "accent":      { "dark": "#FF3B4A", "light": "#C0212F" },
    "surface":     { "dark": "#1A0E11", "light": "#FBEFF0" },
    "border":      { "dark": "#5A2027", "light": "#E3A8AE" },
    "text":        { "dark": "#FF9BA3", "light": "#8C1420" },
    "bodyText":    { "dark": "#D6AEB3", "light": "#6E2027" },
    "hazardBand":  { "height": 6, "angle": 45, "stripe": 6 }
  },
  "warning": {
    "accent":  { "dark": "#FFC93B", "light": "#9A6A00" },
    "surface": { "dark": "#241C08", "light": "#FBF4E4" },
    "border":  { "dark": "#6B5320", "light": "#E0CB93" },
    "title":   { "dark": "#FFD97A", "light": "#6B4E06" },
    "body":    { "dark": "#D9BE7C", "light": "#6B4E06" }
  },
  "edge": {
    "sequence":     { "width": 1.5, "dark": "#5E6E85", "light": "#8A93A3" },
    "join":         { "width": 2.5, "dark": "#C6D2E2", "light": "#16181D" },
    "failed":       { "width": 2.5, "dasharray": "6 4", "dark": "#F2495C", "light": "#C0212F" },
    "completed":    { "width": 2.5, "dark": "#3FBF6F", "light": "#1F8E52" },
    "junctionMarker": { "kind": "diamond", "size": 14, "stroke": 2 }
  },
  "handle": {
    "plain": { "size": 8, "stroke": 1.5, "radius": 2 },
    "join":  { "size": 10, "stroke": 2, "shape": "diamond" }
  },
  "timeline": {
    "barHeight": 30,
    "rowGap": 14,
    "labelColumnWidth": 286,
    "queueSegment": {
      "pattern": "45deg-hatch",
      "dark": { "a": "#232C3D", "b": "#161C28", "border": "#3A465C" },
      "light": { "a": "#E3DFD4", "b": "#F2EFE9", "border": "#C9C3B6" }
    }
  },
  "a11y": {
    "minContrast": 4.5,
    "minContrastLarge": 3.0,
    "largeTextPx": 24,
    "minHitTarget": 44,
    "focusRingWidth": 2
  }
}
