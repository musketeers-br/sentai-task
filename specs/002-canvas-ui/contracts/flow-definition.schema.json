{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentaitask.local/schemas/flow-definition.json",
  "title": "SentaiTask flow definition",
  "description": "The serialised form of a maintenance flow. This is what the canvas produces, what the compiler consumes, and what a flow export/import round-trips. Authoritative over the FlowDefinition shape sketched in openapi.yaml.",
  "type": "object",
  "required": ["schemaVersion", "name", "steps", "edges"],
  "additionalProperties": false,

  "properties": {
    "schemaVersion": { "const": 1 },

    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Unique per instance, case-insensitive."
    },

    "defaultCategory": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "description": "WQM category applied to steps that name none.",
      "default": "SENTAI.DEFAULT"
    },

    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },

    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" },
      "description": "Directed dependencies. MUST be acyclic (FR-003); cycles are rejected at mutation time, not at save."
    },

    "joins": {
      "type": "array",
      "items": { "$ref": "#/$defs/join" },
      "description": "One entry per step with 2+ incoming edges. A step with a single incoming edge has no join entry."
    },

    "canvasGeometry": {
      "type": "object",
      "description": "Presentation only. The dispatcher MUST NOT read this; execution order comes from edges alone.",
      "additionalProperties": false,
      "properties": {
        "viewport": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "zoom": { "type": "number", "minimum": 0.1, "maximum": 4 }
          }
        },
        "nodes": {
          "type": "object",
          "description": "Keyed by step id.",
          "additionalProperties": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "width": { "type": "number" }
            }
          }
        }
      }
    }
  },

  "$defs": {

    "stepId": {
      "type": "string",
      "pattern": "^[0-9A-Za-z_-]{1,8}$",
      "description": "Stable within the flow; rendered as #01, #02, ..."
    },

    "stepType": {
      "type": "string",
      "enum": [
        "integrity-check",
        "compact-globals",
        "defragment-globals",
        "switch-journal",
        "purge-audit-records",
        "purge-task-history",
        "custom"
      ]
    },

    "step": {
      "type": "object",
      "required": ["id", "type", "taskName", "namespace"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "type": { "$ref": "#/$defs/stepType" },
        "taskName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Maps to the Task Manager's TaskName."
        },
        "namespace": {
          "type": "string",
          "pattern": "^[%A-Za-z][A-Za-z0-9]*$",
          "examples": ["USER", "SAMPLES", "DOCBOOK", "%SYS"]
        },
        "databaseDirectory": {
          "type": "string",
          "examples": ["/opt/iris/mgr/user/"],
          "description": "Required by the step types that operate on a database directory."
        },
        "runAsUser": { "type": "string", "maxLength": 64, "examples": ["irisadm"] },
        "parameters": {
          "type": "object",
          "description": "Type-specific. Validated against the step type's own parameter schema before scheduling.",
          "additionalProperties": true
        },
        "timeoutMinutes": {
          "type": "integer",
          "minimum": 0,
          "description": "0 means no timeout."
        },
        "wqmCategory": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
        "customClass": {
          "type": "string",
          "description": "Subclass of %SYS.Task.Definition. Required when type is custom.",
          "examples": ["SENTAI.Task.Custom.RebuildIndices"]
        }
      },

      "allOf": [
        {
          "if": { "properties": { "type": { "const": "custom" } }, "required": ["type"] },
          "then": { "required": ["customClass"] }
        },
        {
          "if": {
            "properties": {
              "type": { "enum": ["integrity-check", "compact-globals", "defragment-globals"] }
            },
            "required": ["type"]
          },
          "then": { "required": ["databaseDirectory"] }
        },
        {
          "if": { "properties": { "type": { "const": "purge-audit-records" } }, "required": ["type"] },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "required": ["daysToKeep"],
                "properties": { "daysToKeep": { "type": "integer", "minimum": 0 } }
              }
            },
            "required": ["parameters"]
          }
        }
      ],

      "$comment": "isDestructive is NOT a property here. It is derived from `type` by the step-type registry and cannot be supplied, overridden or disabled by a client (Constitution I)."
    },

    "edge": {
      "type": "object",
      "required": ["source", "target"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/stepId" },
        "target": { "$ref": "#/$defs/stepId" }
      },
      "$comment": "There is no edge kind. Fan-in rendering is derived from the target's incoming-edge count (FR-004)."
    },

    "join": {
      "type": "object",
      "required": ["target", "policy"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/stepId" },
        "policy": {
          "type": "string",
          "enum": ["ALL_MUST_SUCCEED", "PROCEED_ON_PARTIAL", "MIN_SUCCEEDED"],
          "default": "ALL_MUST_SUCCEED"
        },
        "minSucceeded": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "policy": { "const": "MIN_SUCCEEDED" } }, "required": ["policy"] },
          "then": { "required": ["minSucceeded"] }
        }
      ]
    }
  },

  "examples": [
    {
      "schemaVersion": 1,
      "name": "Heavy maintenance — Saturday 03:00",
      "defaultCategory": "SENTAI.NIGHT",
      "steps": [
        {
          "id": "01", "type": "integrity-check", "taskName": "Integrity check — USER",
          "namespace": "USER", "databaseDirectory": "/opt/iris/mgr/user/",
          "runAsUser": "irisadm", "timeoutMinutes": 90, "wqmCategory": "SENTAI.NIGHT"
        },
        {
          "id": "02", "type": "integrity-check", "taskName": "Integrity check — SAMPLES",
          "namespace": "SAMPLES", "databaseDirectory": "/opt/iris/mgr/samples/",
          "runAsUser": "irisadm", "timeoutMinutes": 45, "wqmCategory": "SENTAI.NIGHT"
        },
        {
          "id": "03", "type": "integrity-check", "taskName": "Integrity check — DOCBOOK",
          "namespace": "DOCBOOK", "databaseDirectory": "/opt/iris/mgr/docbook/",
          "runAsUser": "irisadm", "timeoutMinutes": 45, "wqmCategory": "SENTAI.NIGHT"
        },
        {
          "id": "04", "type": "purge-audit-records", "taskName": "Purge audit records",
          "namespace": "%SYS", "runAsUser": "irisadm", "timeoutMinutes": 20,
          "wqmCategory": "SENTAI.NIGHT", "parameters": { "daysToKeep": 30 }
        },
        {
          "id": "05", "type": "switch-journal", "taskName": "Switch journal",
          "namespace": "%SYS", "runAsUser": "irisadm", "timeoutMinutes": 5,
          "wqmCategory": "SENTAI.NIGHT"
        }
      ],
      "edges": [
        { "source": "01", "target": "04" },
        { "source": "02", "target": "04" },
        { "source": "03", "target": "04" },
        { "source": "04", "target": "05" }
      ],
      "joins": [
        { "target": "04", "policy": "MIN_SUCCEEDED", "minSucceeded": 2 }
      ]
    }
  ]
}
