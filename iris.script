    zn "%SYS"
    // Load ZPM and enable community packages
    do $system.OBJ.Load("/tmp/zpm.xml", "ck")
    zpm "enable -map -globally"
    zpm "enable -community"

    // Unexpire passwords and set up passwordless mode to simplify dev use.
    // ** Comment out these two line for Production use **
    do ##class(Security.Users).UnExpireUserPasswords("*")
    //zpm "install passwordless"

    // Enable callin for Embedded Python - see merge.cpf
    //do ##class(Security.Services).Get("%Service_CallIn",.prop)
    //set prop("Enabled")=1
    //set prop("AutheEnabled")=48
    //do ##class(Security.Services).Modify("%Service_CallIn",.prop)

    // create IRISAPP namespace
    //do $SYSTEM.OBJ.Load("/home/irisowner/dev/App.Installer.cls", "ck")
    //set sc = ##class(App.Installer).setup()

    // The canvas app /csp/sentai (static build baked into /opt/sentai-web) is declared in
    // module.xml and served by sentai.web.StaticFiles without authentication: the operator
    // signs in once, inside the canvas, which gets API tokens; the API stays password + JWT.
    // An anonymous request runs as UnknownUser (no roles), so only the sentai.web package is
    // mapped to its own small database whose resource is publicly readable: it holds that
    // file server's code and nothing else — no data, no other sentai code (IRISAPP_CODE and
    // IRISAPP_DATA keep no public access).
    set webDbDir = "/usr/irissys/mgr/sentaiweb/"
    do ##class(%File).CreateDirectoryChain(webDbDir)
    set sc = ##class(SYS.Database).CreateDatabase(webDbDir)
    set sc = ##class(Security.Resources).Create("%DB_SENTAIWEB", "sentai.web static file server code", "R")
    set db = ##class(SYS.Database).%OpenId(webDbDir), db.ResourceName = "%DB_SENTAIWEB"
    set sc = db.%Save()
    kill dbProps set dbProps("Directory") = webDbDir
    set sc = ##class(Config.Databases).Create("SENTAIWEB", .dbProps)
    kill mapProps set mapProps("Database") = "SENTAIWEB"
    set sc = ##class(Config.MapPackages).Create("IRISAPP", "sentai.web", .mapProps)
    // Entering the IRISAPP namespace requires read on its default globals database. The
    // canvas app (and only it, via MatchRoles in module.xml) gets exactly that: read-only.
    set sc = ##class(Security.Roles).Create("SentaiWebPage", "Anonymous canvas page: enter IRISAPP (read on its default globals database) - nothing else", "%DB_IRISAPP_DATA:R")

    zn "IRISAPP"

    // Create /_vscode web app to support intersystems-community.testingmanager VS Code extension
    zpm "install vscode-per-namespace-settings"

    // Configure %UnitTest in IRISAPP to suit the VS Code extension
    set ^UnitTestRoot="/usr/irissys/.vscode/IRISAPP/UnitTestRoot"

    zpm "load /home/irisowner/dev/ -v":1:1
    halt
